{
  "name": "wordcraft-desktop",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:native": "npm run build && node scripts/smoke-native.mjs",
    "check": "tsc -b && vitest run",
    "desktop:setup": "neu update",
    "desktop:dev": "npm run build && neu run",
    "desktop:run": "neu run",
    "desktop:build": "npm run build && neu build --release --embed-resources",
    "desktop:mac": "node scripts/package-macos.mjs",
    "neu": "neu"
  },
  "dependencies": {
    "@neutralinojs/lib": "6.10.0",
    "@tiptap/extension-character-count": "^3.32.2",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/extension-typography": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "docx": "^9.5.1",
    "dompurify": "^3.3.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@neutralinojs/neu": "11.8.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vitest": "~4.1.12"
  }
}
